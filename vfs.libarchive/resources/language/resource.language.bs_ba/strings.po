msgctxt "Addon Summary"
msgid "Multi-format archive and compression addon"
msgstr "Dodatak za arhiviranje i kompresiju u više formata"

msgctxt "Addon Description"
msgid "This add-on uses the libarchive library to read a variety of archive and compression formats.[CR][CR]Supported formats are:[CR]7z, bz2, gz, tar, tar.bz2, tar.gz, tar.xz, tgz, tbz2, xz, zip"
msgstr "Ovaj dodatak koristi biblioteku libarchive za čitanje raznih arhivskih i komprimiranih formata.[CR][CR]Podržani formati su:[CR]7z, bz2, gz, tar, tar.bz2, tar.gz, tar.xz, tgz, tbz2, xz, zip"

