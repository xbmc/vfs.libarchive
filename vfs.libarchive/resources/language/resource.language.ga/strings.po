msgctxt "Addon Summary"
msgid "Multi-format archive and compression addon"
msgstr "Breiseán cartlainne agus comhbhrúite ilfhormáide"

msgctxt "Addon Description"
msgid "This add-on uses the libarchive library to read a variety of archive and compression formats.[CR][CR]Supported formats are:[CR]7z, bz2, gz, tar, tar.bz2, tar.gz, tar.xz, tgz, tbz2, xz, zip"
msgstr "Úsáideann an breiseán seo leabharlann libarchive chun réimse formáidí cartlainne agus comhbhrúite a léamh.[CR][CR]Is iad seo a leanas na formáidí a dtacaítear leo:[CR]7z, bz2, gz, tar, tar.bz2, tar.gz, tar.xz, tgz, tbz2, xz, zip"

