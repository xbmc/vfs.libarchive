msgctxt "#30000"
msgid "RAR solid archive support unavailable"
msgstr "Podrška za RAR solid arhivu nije dostupna"

msgctxt "#30001"
msgid "Truncated RAR file data"
msgstr "Skraćeni podaci RAR datoteke"

msgctxt "#30002"
msgid "Can't allocate rar data"
msgstr "Ne mogu dodijeliti rar podatke"

msgctxt "#30003"
msgid "Couldn't find out RAR header"
msgstr "Nije pronađeno RAR zaglavlje"

msgctxt "#30004"
msgid "Invalid marker header"
msgstr "Nevažeći zaglavlje markera"

msgctxt "#30005"
msgid "Invalid header size"
msgstr "Nevažeća veličina zaglavlja"

msgctxt "#30006"
msgid "RAR encryption support unavailable"
msgstr "Podrška za RAR enkripciju nije dostupna"

msgctxt "#30007"
msgid "Header CRC error"
msgstr "Greška CRC zaglavlja"

msgctxt "#30008"
msgid "Invalid sizes specified"
msgstr "Navedene su nevažeće veličine"

msgctxt "#30009"
msgid "Bad RAR file"
msgstr "Neispravna RAR datoteka"

msgctxt "#30010"
msgid "Unsupported compression method for RAR file"
msgstr "Nepodržana metoda kompresije za RAR datoteku"

msgctxt "#30011"
msgid "Error during seek within RAR file"
msgstr "Greška prilikom pretraživanja unutar RAR datoteke"

msgctxt "#30012"
msgid "Invalid filename"
msgstr "Nevažeći naziv datoteke"

msgctxt "#30013"
msgid "Mismatch of file parts split across multi-volume archive"
msgstr "Nepodudaranje dijelova datoteke podijeljenih u višetomnoj arhivi"

msgctxt "#30014"
msgid "Header CRC error"
msgstr "Greška CRC zaglavlja"

msgctxt "#30015"
msgid "Parsing filters is unsupported"
msgstr "Parsiranje filtera nije podržano"

msgctxt "#30016"
msgid "Invalid symbol"
msgstr "Nevažeći simbol"

msgctxt "#30017"
msgid "Internal error extracting RAR file"
msgstr "Interna greška prilikom raspakivanja RAR datoteke"
