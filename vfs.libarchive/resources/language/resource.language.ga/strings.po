# Following strings used for addon settings dialog
msgctxt "#30000"
msgid "RAR solid archive support unavailable"
msgstr "Níl tacaíocht chartlann sholadach RAR ar fáil"

msgctxt "#30001"
msgid "Truncated RAR file data"
msgstr "Sonraí comhaid RAR gearrtha"

msgctxt "#30002"
msgid "Can't allocate rar data"
msgstr "Ní féidir sonraí rar a leithdháileadh"

msgctxt "#30003"
msgid "Couldn't find out RAR header"
msgstr "Níorbh fhéidir ceanntásc RAR a aimsiú"

msgctxt "#30004"
msgid "Invalid marker header"
msgstr "Ceanntásc marcóra neamhbhailí"

msgctxt "#30005"
msgid "Invalid header size"
msgstr "Méid ceanntásca neamhbhailí"

msgctxt "#30006"
msgid "RAR encryption support unavailable"
msgstr "Níl tacaíocht criptithe RAR ar fáil"

msgctxt "#30007"
msgid "Header CRC error"
msgstr "Earráid CRC ceanntásca"

msgctxt "#30008"
msgid "Invalid sizes specified"
msgstr "Méideanna neamhbhailí sonraithe"

msgctxt "#30009"
msgid "Bad RAR file"
msgstr "Comhad RAR lochtach"

msgctxt "#30010"
msgid "Unsupported compression method for RAR file"
msgstr "Modh comhbhrúite neamhthacaithe le haghaidh comhad RAR"

msgctxt "#30011"
msgid "Error during seek within RAR file"
msgstr "Earráid le linn cuardaigh laistigh de chomhad RAR"

msgctxt "#30012"
msgid "Invalid filename"
msgstr "Ainm comhaid neamhbhailí"

msgctxt "#30013"
msgid "Mismatch of file parts split across multi-volume archive"
msgstr "Mí-chomhoiriúnacht chodanna comhaid roinnte ar fud cartlann il-imleabhar"

msgctxt "#30014"
msgid "Header CRC error"
msgstr "Earráid CRC ceanntásca"

msgctxt "#30015"
msgid "Parsing filters is unsupported"
msgstr "Ní thacaítear le scagairí parsála"

msgctxt "#30016"
msgid "Invalid symbol"
msgstr "Siombail neamhbhailí"

msgctxt "#30017"
msgid "Internal error extracting RAR file"
msgstr "Earráid inmheánach agus comhad RAR á bhaint amach"
